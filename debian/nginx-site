# Example site for the Ishtaria portal. Enable with:
#   ln -s /etc/nginx/sites-available/ishtaria-web /etc/nginx/sites-enabled/
# Put TLS in front of it (certbot or your proxy) before exposing it publicly.
server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/ishtaria-web/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # The browser (HTML5 / WebAssembly) client of the ishtaria-client-web package, if installed. A build without threads needs
    # no special headers; the .wasm must be served as application/wasm (nginx's mime.types has it).
    # Per-instance default API URL: edit /etc/ishtaria/client-web-config.js (window.ISHTARIA_SERVER_URL).
    location = /play/ishtaria-config.js {
        alias /etc/ishtaria/client-web-config.js;
        add_header Cache-Control "no-cache";
        default_type application/javascript;
    }
    location /play/ {
        alias /usr/share/ishtaria-client-web/html/;
        try_files $uri $uri/ =404;
        add_header Cache-Control "public, max-age=3600";
        gzip_static on;
    }

    # A game server for the browser client on THIS origin, so that it needs no CORS and no mixed content: set
    # window.ISHTARIA_SERVER_URL = "/server" in /etc/ishtaria/client-web-config.js (or use /play/?server=/server).
    # Uncomment and point it at your server (TLS belongs in front of this site).
    #location /server/ {
    #    proxy_pass http://127.0.0.1:7400/;
    #    proxy_set_header Host $host;
    #    proxy_set_header X-Forwarded-For $remote_addr;
    #    client_max_body_size 1m;
    #}

    # Documentation from the ishtaria-doc package, if installed.
    location /doc/ishtaria-doc/ {
        alias /usr/share/doc/ishtaria-doc/;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
}
